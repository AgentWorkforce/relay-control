  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "description": "Minimal self-hosted Agent Relay sessions control plane",
  "bin": {
    "agent-relay-selfhost-api": "./dist/server.js",
    "agent-relay-selfhost-migrate": "./dist/migrate-cli.js",
