{
  "description": "Request-gate cases for every Desktop feed operation (credential precedence, entitlement, resource). Status: proposed. Credentials are described, never present: no token value appears here. State from feed-state.json.",
  "operations": {
    "manifest": [
      "get",
      "/api/v1/desktop/feed/manifest"
    ],
    "releases": [
      "get",
      "/api/v1/desktop/feed/releases"
    ],
    "download_url": [
      "post",
      "/api/v1/desktop/feed/assets/{assetId}/download-url"
    ],
    "asset": [
      "get",
      "/api/v1/desktop/feed/assets/{assetId}"
    ],
    "install_tokens_list": [
      "get",
      "/api/v1/desktop/feed/install-tokens"
    ],
    "install_tokens_create": [
      "post",
      "/api/v1/desktop/feed/install-tokens"
    ],
    "install_tokens_revoke": [
      "delete",
      "/api/v1/desktop/feed/install-tokens/{tokenId}"
    ],
    "create_draft": [
      "post",
      "/api/v1/desktop/feed/releases"
    ],
    "import": [
      "post",
      "/api/v1/desktop/feed/releases/import"
    ],
    "upload": [
      "put",
      "/api/v1/desktop/feed/releases/{version}/assets/{name}"
    ],
    "publish": [
      "post",
      "/api/v1/desktop/feed/releases/{version}/publish"
    ]
  },
  "cases": [
